pipeline {
    agent any

    environment {
        VENV_DIR = 'venv'
    }

    stages {
        stage('Préparation') {
            steps {
                echo '🔧 Création de l\'environnement virtuel et installation des dépendances'
                sh '''
                    python3 -m venv ${VENV_DIR}
                    . ${VENV_DIR}/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }

        stage('Vérifications de base') {
            steps {
                echo '🔎 Lint du code avec flake8'
                sh '''
                    . ${VENV_DIR}/bin/activate
                    flake8 --exclude=${VENV_DIR}
                    black --check . || true  # black échoue si ça formate quelque chose
                '''
            }
        }

        stage('Tests') {
            steps {
                echo '🧪 Lancement des tests'
                sh '''
                    . ${VENV_DIR}/bin/activate
                    python manage.py check
                    python manage.py test
                '''
            }
        }
    }

    post {
        always {
            echo '🧼 Nettoyage du workspace'
            cleanWs()
        }

        failure {
            echo '❌ Pipeline échoué. Consultez les logs pour plus de détails.'
        }
    }
}
