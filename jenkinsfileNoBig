pipeline {
    agent any

    environment {
        SONAR_TOKEN = credentials('sonarqube-token') // Assure-toi que le token est bien dans Credentials
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'Jenkins', url: 'https://github.com/Karloxee/makeapi.git'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    // Charger automatiquement l'outil installé
                    def scannerHome = tool 'SonarScanner'
                    sh """
                        ${scannerHome}/bin/sonar-scanner \
                          -Dsonar.projectKey=makeapi \
                          -Dsonar.sources=. \
                          -Dsonar.host.url=$SONAR_HOST_URL \
                          -Dsonar.login=$SONAR_TOKEN
                    """
                }
            }
        }
    }
}
