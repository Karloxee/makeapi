pipeline {
    agent any

    environment {
        SONAR_TOKEN = credentials('sonarqube-token') // si tu utilises un token
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'Jenkins', url: 'https://github.com/Karloxee/makeapi.git'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') { // nom exact de ton instance SonarQube dans Jenkins
                    sh '''
                        sonar-scanner \
                          -Dsonar.projectKey=makeapi \
                          -Dsonar.sources=. \
                          -Dsonar.host.url=http://<URL_DE_TON_SONARQUBE> \
                          -Dsonar.login=$SONAR_TOKEN
                    '''
                }
            }
        }
    }
}
