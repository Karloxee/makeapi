pipeline {
    agent any

    stages {
        stage('Clone Repository') {
            steps {
                git url: 'https://github.com/Karloxee/makeapi.git', branch: 'Jenkins'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install -r requirements.txt
                '''
            }
        }

        stage('Install Dependencies2 flake8, isort, black') {
            steps {
                sh '''
                    . venv/bin/activate
                    pip install flake8 black isort
                '''
            }
        }

        stage('Lint and Format Check') {
            steps {
                sh '''
                    . venv/bin/activate
                    black --check .
                    isort . --check-only
                    flake8 .
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh 'pytest' // ou le framework que tu utilises
            }
        }

        // autres étapes : build Docker, push image, deploy, etc.
    }
}

