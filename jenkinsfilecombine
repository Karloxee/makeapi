pipeline {
    agent any
    environment {
        VENV_DIR = 'venv'
    }
    stages {
        stage('Clone Repository') {  // Gardé de p1 - plus explicite
            steps {
                git url: 'https://github.com/Karloxee/makeapi.git', branch: 'Jenkins'
            }
        }
        stage('Préparation') {  // De p2
            steps {
                sh '''
                    python3 -m venv ${VENV_DIR}
                    . ${VENV_DIR}/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                    pip install flake8 black isort
                '''
            }
        }
        stage('Qualité du code') {
            steps {
                sh '''
                    . ${VENV_DIR}/bin/activate
                    echo "🔍 Vérification de la qualité du code"
                    flake8 --exclude=${VENV_DIR} || echo "⚠️ Problèmes de style détectés"
                    black --check . || echo "⚠️ Reformattage nécessaire"
                    isort . --check-only || echo "⚠️ Tri des imports nécessaire"
                '''
            }
        }
        stage('Tests Django') {  // De p2 - plus approprié
            steps {
                sh '''
                    . ${VENV_DIR}/bin/activate
                    python manage.py check
                    python manage.py test
                '''
            }
        }
    }
    post {  // Essentiel de p2
        always { cleanWs() }
        failure { echo '❌ Pipeline échoué' }
    }
}
